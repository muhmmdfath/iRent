{
  "name": "irent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "iRent Semarang API and PostgreSQL business data",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "npm run db:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prisma format && prettier --write src test prisma.config.ts *.json *.mjs *.md",
    "format:check": "prettier --check src test prisma.config.ts *.json *.mjs *.md",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:db": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/database/*.test.js",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "node dist/auth/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
