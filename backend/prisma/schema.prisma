// Business timestamps store WIB wall-clock values, not implicit UTC instants.
// Use shared/time/wib.ts at API boundaries. SQL maintains updated_at in WIB.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin

  @@map("user_role")
}

enum ItemCategory {
  iphone
  accessory

  @@map("item_category")
}

enum UnitCondition {
  layak
  maintenance
  lost

  @@map("unit_condition")
}

enum PhysicalStatus {
  ready
  in_use
  awaiting_check
  in_transit
  preparing
  lost

  @@map("physical_status")
}

enum BookingStatus {
  menunggu_pembayaran
  menunggu_konfirmasi
  dikonfirmasi
  berjalan
  selesai
  kedaluwarsa
  ditolak
  dibatalkan

  @@map("booking_status")
}

enum DeliveryType {
  pickup
  delivery

  @@map("delivery_type")
}

enum PayOption {
  dp
  full

  @@map("pay_option")
}

enum UnitUseStatus {
  allocated
  in_use
  return_pending
  returned
  lost_closed

  @@map("unit_use_status")
}

enum AllocationKind {
  rental
  extension_hold

  @@map("allocation_kind")
}

enum AllocationState {
  active
  released

  @@map("allocation_state")
}

enum ExtensionStatus {
  draft_quote
  menunggu_pembayaran
  menunggu_konfirmasi
  disetujui
  ditolak
  kedaluwarsa
  dibatalkan

  @@map("extension_status")
}

enum ReturnStatus {
  pending
  verified
  rejected

  @@map("return_status")
}

enum ChargeKind {
  rental
  delivery
  extension
  extra_delivery
  late
  damage
  loss
  adjustment

  @@map("charge_kind")
}

enum ChargeDirection {
  debit
  credit

  @@map("charge_direction")
}

enum ObligationPurpose {
  initial_dp
  initial_full
  settlement
  extension

  @@map("obligation_purpose")
}

enum ObligationStatus {
  open
  proof_pending
  satisfied
  closed

  @@map("obligation_status")
}

enum ProofStatus {
  pending
  verified
  rejected

  @@map("proof_status")
}

enum MoneyDirection {
  in
  out

  @@map("money_direction")
}

enum PaymentType {
  dp
  full
  settlement
  extension
  refund
  reconciliation

  @@map("payment_type")
}

enum PaymentMethod {
  qris
  cash
  transfer

  @@map("payment_method")
}

enum ApplicationState {
  reserved
  applied
  released

  @@map("application_state")
}

enum RefundStatus {
  diajukan
  disetujui
  ditolak
  sudah_dikembalikan

  @@map("refund_status")
}

enum IdempotencyStatus {
  processing
  succeeded

  @@map("idempotency_status")
}

enum NotificationChannel {
  push
  whatsapp

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  sending
  sent
  failed
  skipped

  @@map("notification_status")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  authVersion  Int      @default(0) @map("auth_version")
  role         UserRole @default(customer)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  profile                              CustomerProfile?       @relation("CustomerProfile_userId")
  sessions                             AuthSession[]
  bookings                             Booking[]              @relation("Booking_userId")
  pushSubscriptions                    PushSubscription[]     @relation("PushSubscription_userId")
  bookingConfirmedBy                   Booking[]              @relation("Booking_confirmedBy")
  bookingItemPickedUpBy                BookingItem[]          @relation("BookingItem_pickedUpBy")
  extensionQuotedBy                    Extension[]            @relation("Extension_quotedBy")
  extensionApprovedBy                  Extension[]            @relation("Extension_approvedBy")
  returnRecordVerifiedBy               ReturnRecord[]         @relation("ReturnRecord_verifiedBy")
  lossRecordVerifiedBy                 LossRecord[]           @relation("LossRecord_verifiedBy")
  bookingChargeCreatedBy               BookingCharge[]        @relation("BookingCharge_createdBy")
  paymentProofReviewedBy               PaymentProof[]         @relation("PaymentProof_reviewedBy")
  paymentRecordedBy                    Payment[]              @relation("Payment_recordedBy")
  refundRequestApprovedBy              RefundRequest[]        @relation("RefundRequest_approvedBy")
  bookingStatusLogActorId              BookingStatusLog[]     @relation("BookingStatusLog_actorId")
  auditLogActorId                      AuditLog[]             @relation("AuditLog_actorId")
  settingUpdatedBy                     Setting[]              @relation("Setting_updatedBy")
  idempotencyRequestActorId            IdempotencyRequest[]   @relation("IdempotencyRequest_actorId")
  notificationDeliveryRecipientAdminId NotificationDelivery[] @relation("NotificationDelivery_recipientAdminId")

  @@map("users")
}

model CustomerProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  fullName      String   @map("full_name")
  address       String
  phoneActive   String   @map("phone_active")
  nikCiphertext String   @map("nik_ciphertext")
  phoneAlt      String?  @map("phone_alt")
  instagram     String?
  emailContact  String?  @map("email_contact")
  completedAt   DateTime @map("completed_at") @db.Timestamp(3)
  createdAt     DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  user User @relation("CustomerProfile_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("customer_profiles")
}

model Item {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  ItemCategory
  name      String
  photoPath String?      @map("photo_path")
  includes  Json
  price6h   BigInt       @map("price_6h")
  price12h  BigInt       @map("price_12h")
  price24h  BigInt       @map("price_24h")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  units        ItemUnit[]    @relation("ItemUnit_itemId")
  bookingItems BookingItem[] @relation("BookingItem_itemId")

  @@map("items")
}

model ItemUnit {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId                 String         @map("item_id") @db.Uuid
  code                   String         @unique
  isActive               Boolean        @default(true) @map("is_active")
  conditionStatus        UnitCondition  @default(layak) @map("condition_status")
  physicalStatus         PhysicalStatus @default(ready) @map("physical_status")
  preparationUntil       DateTime?      @map("preparation_until") @db.Timestamp(3)
  maintenanceCompletedAt DateTime?      @map("maintenance_completed_at") @db.Timestamp(3)
  notes                  String?
  createdAt              DateTime       @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt              DateTime       @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  item         Item             @relation("ItemUnit_itemId", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingItems BookingItem[]    @relation("BookingItem_itemUnitId")
  allocations  UnitAllocation[] @relation("UnitAllocation_itemUnitId")

  @@unique([id, itemId])
  @@index([itemId, isActive, conditionStatus])
  @@index([physicalStatus, preparationUntil])
  @@map("item_units")
}

model DeliveryZone {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  fee       BigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  bookings Booking[] @relation("Booking_deliveryZoneId")

  @@map("delivery_zones")
}

model Booking {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                       String        @unique
  userId                     String        @map("user_id") @db.Uuid
  status                     BookingStatus @default(menunggu_pembayaran)
  initialStartAt             DateTime      @map("initial_start_at") @db.Timestamp(3)
  initialEndAt               DateTime      @map("initial_end_at") @db.Timestamp(3)
  deliveryType               DeliveryType  @map("delivery_type")
  deliveryZoneId             String?       @map("delivery_zone_id") @db.Uuid
  deliveryZoneNameSnapshot   String?       @map("delivery_zone_name_snapshot")
  deliveryAddress            String?       @map("delivery_address")
  deliveryFeeSnapshot        BigInt        @map("delivery_fee_snapshot")
  initialRentalTotal         BigInt        @map("initial_rental_total")
  initialGrandTotal          BigInt        @map("initial_grand_total")
  dpSnapshot                 BigInt        @map("dp_snapshot")
  payOption                  PayOption     @map("pay_option")
  amountDueNow               BigInt        @map("amount_due_now")
  expiresAt                  DateTime      @map("expires_at") @db.Timestamp(3)
  uploadedAt                 DateTime?     @map("uploaded_at") @db.Timestamp(3)
  confirmationDueAt          DateTime?     @map("confirmation_due_at") @db.Timestamp(3)
  confirmedBy                String?       @map("confirmed_by") @db.Uuid
  confirmedAt                DateTime?     @map("confirmed_at") @db.Timestamp(3)
  noShowDueAt                DateTime      @map("no_show_due_at") @db.Timestamp(3)
  deliveryReadyAt            DateTime?     @map("delivery_ready_at") @db.Timestamp(3)
  customerFailureConfirmedAt DateTime?     @map("customer_failure_confirmed_at") @db.Timestamp(3)
  deliveryFailureReason      String?       @map("delivery_failure_reason")
  shopDelaySeconds           Int           @default(0) @map("shop_delay_seconds")
  rejectedReason             String?       @map("rejected_reason")
  cancelReason               String?       @map("cancel_reason")
  termsVersion               String        @map("terms_version")
  agreedTermsAt              DateTime      @map("agreed_terms_at") @db.Timestamp(3)
  rulesSnapshot              Json          @map("rules_snapshot")
  createdAt                  DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt                  DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  customer           User                @relation("Booking_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryZone       DeliveryZone?       @relation("Booking_deliveryZoneId", fields: [deliveryZoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items              BookingItem[]       @relation("BookingItem_bookingId")
  extensions         Extension[]         @relation("Extension_bookingId")
  charges            BookingCharge[]     @relation("BookingCharge_bookingId")
  obligations        PaymentObligation[] @relation("PaymentObligation_bookingId")
  payments           Payment[]           @relation("Payment_bookingId")
  receiptCorrections ReceiptCorrection[]
  refunds            RefundRequest[]     @relation("RefundRequest_bookingId")
  statusLogs         BookingStatusLog[]  @relation("BookingStatusLog_bookingId")
  confirmedActor     User?               @relation("Booking_confirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, initialStartAt])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([confirmationDueAt])
  @@index([noShowDueAt])
  @@map("bookings")
}

model BookingItem {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  itemId            String        @map("item_id") @db.Uuid
  itemUnitId        String        @map("item_unit_id") @db.Uuid
  itemNameSnapshot  String        @map("item_name_snapshot")
  unitCodeSnapshot  String        @map("unit_code_snapshot")
  initialStartAt    DateTime      @map("initial_start_at") @db.Timestamp(3)
  startAt           DateTime      @map("start_at") @db.Timestamp(3)
  initialEndAt      DateTime      @map("initial_end_at") @db.Timestamp(3)
  currentEndAt      DateTime      @map("current_end_at") @db.Timestamp(3)
  shopDelaySeconds  Int           @default(0) @map("shop_delay_seconds")
  unitPriceSnapshot BigInt        @map("unit_price_snapshot")
  tariff6hSnapshot  BigInt        @map("tariff_6h_snapshot")
  tariff12hSnapshot BigInt        @map("tariff_12h_snapshot")
  tariff24hSnapshot BigInt        @map("tariff_24h_snapshot")
  useStatus         UnitUseStatus @default(allocated) @map("use_status")
  pickedUpAt        DateTime?     @map("picked_up_at") @db.Timestamp(3)
  pickedUpBy        String?       @map("picked_up_by") @db.Uuid
  handoverNote      String?       @map("handover_note")
  version           Int           @default(0)
  createdAt         DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  booking        Booking          @relation("BookingItem_bookingId", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  item           Item             @relation("BookingItem_itemId", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit           ItemUnit         @relation("BookingItem_itemUnitId", fields: [itemUnitId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Cascade, map: "booking_item_unit_matches_item")
  allocations    UnitAllocation[] @relation("UnitAllocation_bookingItemId")
  extensionItems ExtensionItem[]  @relation("ExtensionItem_bookingItemId")
  returnRecord   ReturnRecord?    @relation("ReturnRecord_bookingItemId")
  lossRecord     LossRecord?      @relation("LossRecord_bookingItemId")
  charges        BookingCharge[]  @relation("BookingCharge_bookingItemId")
  pickedUpActor  User?            @relation("BookingItem_pickedUpBy", fields: [pickedUpBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([bookingId, itemUnitId])
  @@unique([id, bookingId])
  @@unique([id, itemUnitId])
  @@index([bookingId, useStatus])
  @@index([itemUnitId, currentEndAt])
  @@map("booking_items")
}

model UnitAllocation {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingItemId   String          @map("booking_item_id") @db.Uuid
  itemUnitId      String          @map("item_unit_id") @db.Uuid
  extensionItemId String?         @map("extension_item_id") @db.Uuid
  allocationKind  AllocationKind  @map("allocation_kind")
  state           AllocationState @default(active)
  startAt         DateTime        @map("start_at") @db.Timestamp(3)
  endAt           DateTime        @map("end_at") @db.Timestamp(3)
  blockStartAt    DateTime        @map("block_start_at") @db.Timestamp(3)
  blockEndAt      DateTime        @map("block_end_at") @db.Timestamp(3)
  holdExpiresAt   DateTime?       @map("hold_expires_at") @db.Timestamp(3)
  releasedAt      DateTime?       @map("released_at") @db.Timestamp(3)
  releasedReason  String?         @map("released_reason")
  createdAt       DateTime        @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime        @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  bookingItem   BookingItem    @relation("UnitAllocation_bookingItemId", fields: [bookingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit          ItemUnit       @relation("UnitAllocation_itemUnitId", fields: [itemUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  extensionItem ExtensionItem? @relation("UnitAllocation_extensionItemId", fields: [extensionItemId, bookingItemId], references: [id, bookingItemId], onDelete: Restrict, onUpdate: Cascade, map: "allocation_extension_matches_item")

  @@index([itemUnitId, state, blockStartAt])
  @@index([holdExpiresAt])
  @@map("unit_allocations")
}

model Extension {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String          @map("booking_id") @db.Uuid
  status             ExtensionStatus
  rentalQuoteTotal   BigInt          @map("rental_quote_total")
  extraDeliveryQuote BigInt          @default(0) @map("extra_delivery_quote")
  amountDue          BigInt          @map("amount_due")
  deliveryQuoteNote  String?         @map("delivery_quote_note")
  quotedBy           String?         @map("quoted_by") @db.Uuid
  quotedAt           DateTime?       @map("quoted_at") @db.Timestamp(3)
  deliveryAgreedAt   DateTime?       @map("delivery_agreed_at") @db.Timestamp(3)
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamp(3)
  expiresAt          DateTime?       @map("expires_at") @db.Timestamp(3)
  uploadedAt         DateTime?       @map("uploaded_at") @db.Timestamp(3)
  confirmationDueAt  DateTime?       @map("confirmation_due_at") @db.Timestamp(3)
  approvedBy         String?         @map("approved_by") @db.Uuid
  approvedAt         DateTime?       @map("approved_at") @db.Timestamp(3)
  rejectedReason     String?         @map("rejected_reason")
  cancelReason       String?         @map("cancel_reason")
  createdAt          DateTime        @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime        @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  booking       Booking             @relation("Extension_bookingId", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         ExtensionItem[]     @relation("ExtensionItem_extensionId")
  charges       BookingCharge[]     @relation("BookingCharge_extensionId")
  obligations   PaymentObligation[] @relation("PaymentObligation_extensionId")
  payments      Payment[]           @relation("Payment_extensionId")
  refunds       RefundRequest[]     @relation("RefundRequest_extensionId")
  quotedActor   User?               @relation("Extension_quotedBy", fields: [quotedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedActor User?               @relation("Extension_approvedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, bookingId])
  @@index([status, expiresAt])
  @@index([confirmationDueAt])
  @@index([status, createdAt, id])
  @@map("extensions")
}

model ExtensionItem {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  extensionId         String    @map("extension_id") @db.Uuid
  bookingId           String    @map("booking_id") @db.Uuid
  bookingItemId       String    @map("booking_item_id") @db.Uuid
  oldEndAt            DateTime  @map("old_end_at") @db.Timestamp(3)
  proposedEndAt       DateTime  @map("proposed_end_at") @db.Timestamp(3)
  expectedItemVersion Int       @map("expected_item_version")
  addedHours          Int       @map("added_hours")
  unitPriceSnapshot   BigInt    @map("unit_price_snapshot")
  confirmationDueAt   DateTime? @map("confirmation_due_at") @db.Timestamp(3)
  createdAt           DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  allocations UnitAllocation[] @relation("UnitAllocation_extensionItemId")
  extension   Extension        @relation("ExtensionItem_extensionId", fields: [extensionId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: Cascade, map: "extension_item_matches_parent")
  bookingItem BookingItem      @relation("ExtensionItem_bookingItemId", fields: [bookingItemId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: Cascade, map: "extension_item_matches_booking")

  @@unique([extensionId, bookingItemId])
  @@unique([id, bookingItemId])
  @@index([bookingItemId])
  @@map("extension_items")
}

model ReturnRecord {
  id                           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingItemId                String       @unique @map("booking_item_id") @db.Uuid
  status                       ReturnStatus @default(pending)
  reportedAt                   DateTime?    @map("reported_at") @db.Timestamp(3)
  receivedByCourierAt          DateTime?    @map("received_by_courier_at") @db.Timestamp(3)
  receivedAtStore              DateTime?    @map("received_at_store") @db.Timestamp(3)
  verifiedAt                   DateTime?    @map("verified_at") @db.Timestamp(3)
  verifiedBy                   String?      @map("verified_by") @db.Uuid
  feeReturnAt                  DateTime?    @map("fee_return_at") @db.Timestamp(3)
  conditionNote                String?      @map("condition_note")
  damageAmount                 BigInt       @default(0) @map("damage_amount")
  damageNote                   String?      @map("damage_note")
  lateSeconds                  Int          @default(0) @map("late_seconds")
  lateFee                      BigInt       @default(0) @map("late_fee")
  adminDelayExemptionSeconds   Int          @default(0) @map("admin_delay_exemption_seconds")
  courierDelayExemptionSeconds Int          @default(0) @map("courier_delay_exemption_seconds")
  exemptionReason              String?      @map("exemption_reason")
  manualExemptions             Json         @default("[]") @map("manual_exemptions")
  preparationStartedAt         DateTime?    @map("preparation_started_at") @db.Timestamp(3)
  createdAt                    DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt                    DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  bookingItem   BookingItem @relation("ReturnRecord_bookingItemId", fields: [bookingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedActor User?       @relation("ReturnRecord_verifiedBy", fields: [verifiedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status])
  @@index([status, createdAt, id])
  @@map("return_records")
}

model LossRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingItemId      String   @unique @map("booking_item_id") @db.Uuid
  lostAt             DateTime @map("lost_at") @db.Timestamp(3)
  verifiedBy         String   @map("verified_by") @db.Uuid
  verifiedAt         DateTime @map("verified_at") @db.Timestamp(3)
  lossNote           String   @map("loss_note")
  compensationAmount BigInt   @map("compensation_amount")
  lateFee            BigInt   @map("late_fee")
  policySnapshot     Json     @map("policy_snapshot")
  createdAt          DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jakarta'::text)")) @map("updated_at") @db.Timestamp(3)

  bookingItem   BookingItem @relation("LossRecord_bookingItemId", fields: [bookingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedActor User        @relation("LossRecord_verifiedBy", fields: [verifiedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("loss_records")
}

model BookingCharge {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String          @map("booking_id") @db.Uuid
  bookingItemId   String?         @map("booking_item_id") @db.Uuid
  extensionId     String?         @map("extension_id") @db.Uuid
  kind            ChargeKind
  direction       ChargeDirection
  amount          BigInt
  relatedChargeId String?         @map("related_charge_id") @db.Uuid
  effectiveAt     DateTime        @map("effective_at") @db.Timestamp(3)
  reason          String?
