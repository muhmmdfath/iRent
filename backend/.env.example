NODE_ENV=development
PORT=3000
# Use a dedicated iRent database. Encode special characters in credentials.
DATABASE_URL=postgresql://irent:irent_local@127.0.0.1:55432/irent
# Exact frontend origins are required, never '*' with credentials.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Generate independent random 32-byte base64 keys locally; do not commit them.
CSRF_SECRET=
NIK_KEYS=
NIK_ACTIVE_KEY=v1
# Private storage; never expose this directory through a static/public route.
# Set an absolute persistent path when deploying or running multiple instances.
PROOF_STORAGE_DIR=storage/proofs
# Public sanitized item/QRIS images; keep disjoint from private proofs.
MEDIA_STORAGE_DIR=storage/media
PAYMENT_WORKER_ENABLED=true
NO_SHOW_WORKER_ENABLED=true

EXTENSION_WORKER_ENABLED=true
RISK_WORKER_ENABLED=true
NOTIFICATION_WORKER_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
