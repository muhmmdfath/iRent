{$DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    @private path /admin /admin/* /app /app/* /login /register
    header @private X-Robots-Tag "noindex, nofollow"
    @api path /api/* /media/*
    handle @api {
        reverse_proxy api:3030
    }
    handle {
        root * /srv
        @worker path /sw.js /admin/sw.js /manifest.webmanifest /admin/manifest.webmanifest
        header @worker Cache-Control "no-cache"
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @static path /assets/* /brand/* /images/* /robots.txt /sitemap.xml /admin/*.js /admin/*.png /admin/*.webmanifest /sw.js /manifest.webmanifest
        handle @static {
            file_server
        }
        @homepage path /
        handle @homepage {
            rewrite * /index.html
            file_server
        }
        handle {
            try_files {path} {path}.html /app-shell.html
            file_server
        }
    }
}
